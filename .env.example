# Copy to .env and fill in. .env is gitignored — never commit the real file.

# --- OC Transpo GTFS-Realtime (Azure API Management) -----------------------
# Get these from https://nextrip-public-api.developer.azure-api.net/
# Azure APIM issues two keys so you can rotate without downtime:
# use the primary, keep the secondary as the spare.
OC_TRANSPO_PRIMARY_KEY=
OC_TRANSPO_SECONDARY_KEY=

# --- Capture settings ------------------------------------------------------
# Default seconds between polls, applied to any feed without its own override.
# 45s is measured, not guessed: buses update their own timestamp every 60s at
# the median, so polling every 30s returned the same reading twice 57.5% of the
# time. See docs/DECISIONS.md #1.
CAPTURE_INTERVAL_SECONDS=45

# TripUpdates is ~331 KB per response against VehiclePositions' ~38 KB, so it
# drives almost all the load. At 120s it stays analytically equivalent (predicted
# arrival times don't change meaningfully inside 30s) while cutting what we pull
# from OC Transpo from ~32 GB/month to ~10 GB/month. See DECISIONS.md #1 and #9.
CAPTURE_INTERVAL_TRIP_UPDATES_SECONDS=120

# Uncomment only if you want VehiclePositions at something other than the
# default above. 30s already tracks the feed's own refresh rate (median
# staleness 13s), so polling faster just returns duplicates.
# CAPTURE_INTERVAL_VEHICLE_POSITIONS_SECONDS=30

# Where raw gzipped frames are written. On the VM this is a real path;
# locally it can be ./raw
CAPTURE_OUTPUT_DIR=./raw

# --- Pulling the archive off the phone --------------------------------------
# The phone serves its raw/ folder over the local network; scripts/pull_from_phone.py
# copies anything new into this machine's raw/. Set a DHCP reservation on your
# router so this address doesn't change.
PHONE_RAW_URL=http://192.168.1.5:8000

# --- Hugging Face (running capture in a Space) ------------------------------
# Write token from https://huggingface.co/settings/tokens — never commit it.
HF_TOKEN=
# Where the Space uploads the raw archive, and where the laptop downloads it.
HF_DATASET_REPO_ID=
# The Space that runs capture, e.g. yourname/duckstream-capture
HF_SPACE_REPO_ID=

# --- Groq (Phase 4 only, not needed yet) -----------------------------------
GROQ_API_KEY=
# Do NOT hardcode a model name in source. Pick the current fast/cheap Groq
# model at build time and set it here. See docs/DECISIONS.md #5
GROQ_MODEL=

# --- Redpanda (Phase 1+, local laptop) -------------------------------------
REDPANDA_BROKERS=localhost:19092
