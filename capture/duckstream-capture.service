# systemd unit for the always-on capture VM.
#
# Install:
#   sudo cp capture/duckstream-capture.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now duckstream-capture
#
# Adjust User/paths if you're not on the default Ubuntu image.

[Unit]
Description=DuckStream raw GTFS-RT capture
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/duckstream

# Key and settings live here, mode 600, outside the git repo.
EnvironmentFile=/etc/duckstream/capture.env

ExecStart=/home/ubuntu/duckstream/.venv/bin/python /home/ubuntu/duckstream/capture/capture.py

# Always come back. This is the component that must not stay down.
Restart=always
RestartSec=10

# SIGTERM lets the script finish its current request and write before exiting.
# Frames are complete gzip members and each run starts its own file, so even a
# hard kill costs at most the one frame being written — but there's no reason
# to create that problem.
KillSignal=SIGTERM
TimeoutStopSec=60

StandardOutput=journal
StandardError=journal
SyslogIdentifier=duckstream-capture

[Install]
WantedBy=multi-user.target
